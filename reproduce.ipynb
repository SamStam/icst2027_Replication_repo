   "outputs": [],
   "source": [
    "def admit(mission, folder, W):\n",
    "    files = sorted(glob.glob(os.path.join(DATA, 'physical', folder, '*.csv')))\n",
    "    passed, out = [], []\n",
    "    for f in files:\n",
    "        d = load(f)\n",
    "        why = check_trace(d, mission)\n",
    "        (out if why else passed).append((d, why))\n",
    "\n",
    "    keep, med, ref = check_coherence([d for d, _ in passed], W)\n",
    "    for i, (d, _) in enumerate(passed):\n",
    "        if i not in keep:\n",
    "            out.append((d, 'referent coherence (%.1fx set median)' % (med[i] / ref)))\n",
    "\n",
    "    print('%s: %d flown, %d rejected, %d admitted'\n",
    "          % (mission, len(files), len(out), len(keep)))\n",
    "    for d, why in sorted(out, key=lambda t: t[0].attrs['id']):\n",
    "        print('   %s  %s' % (d.attrs['id'], why))\n",
    "    return [passed[i][0] for i in keep]"
   ]
  },
