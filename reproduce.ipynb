   "source": [
    "def check_trace(d, mission):\n",
    "    \"\"\"Conditions i-iv. Each looks at one trace on its own.\"\"\"\n",
    "    n = N_NOMINAL[mission]\n",
    "    if len(d) < MIN_COMPLETE * n:\n",
    "        return f'completeness ({len(d)}/{n} samples)'\n",
    "\n",
    "    same = (d[AX].diff() == 0).all(axis=1).astype(int)\n",
    "    if same.groupby((same == 0).cumsum()).cumsum().max() > FROZEN_RUN:\n",
    "        return 'frozen link'\n",
    "\n",
    "    s = steps(d)\n",
    "    if (s > JUMP_REJECT).any():\n",
    "        big = np.sort(s[s > JUMP_REJECT])[::-1] * 100\n",
    "        return 'relocalisation (max %.1f cm)' % big[0]\n",
    "    if (s > JUMP_REPAIR).mean() > REPAIR_BUDGET:\n",
    "        return 'repair budget (%.1f%%)' % ((s > JUMP_REPAIR).mean() * 100)\n",
    "    return None"
   ]
  },
