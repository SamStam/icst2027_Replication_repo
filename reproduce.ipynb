     "shell.execute_reply": "2026-11-07T17:44:11.539285Z"
    }
   },
   "outputs": [],
   "source": [
    "def on_grid(d, W):\n",
    "    t = np.arange(W[0], W[1], 1 / HZ)\n",
    "    return np.column_stack([np.interp(t, d.t_mission, d[f'e{c}']) for c in AX])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "fbbf31f3",
   "metadata": {
    "execution": {
