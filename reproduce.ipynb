    "def relocalised_traces():\n",
    "    print('\\nrejected square traces, largest jumps')\n",
    "    for f in sorted(glob.glob(os.path.join(DATA, 'physical', 'square_relocalised', '*.csv'))):\n",
    "        d = load(f)\n",
    "        s = np.sort(steps(d)[steps(d) > JUMP_REJECT])[::-1] * 100\n",
    "        print('   %s  %s cm' % (d.attrs['id'], ', '.join('%.1f' % v for v in s[:4])))\n",
    "    # 11.1 cm/s at 50 Hz is 0.2 cm between samples; these are two orders out\n",
    "    sq = [load(f) for f in sorted(glob.glob(os.path.join(DATA, 'physical', 'square', '*.csv')))]\n",
    "    bad = [load(f) for f in sorted(glob.glob(os.path.join(DATA, 'physical', 'square_relocalised', '*.csv')))]\n",
    "    print('   band without them %.2f cm, with them %.2f cm'\n",
    "          % (band(sq, W_SQUARE) * 100, band(sq + bad, W_SQUARE) * 100))"
   ]
