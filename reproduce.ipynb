    "def robustness(admitted, W):\n",
    "    print('\\nsquare band under five variants')\n",
    "    for q in (75, 90, 95):\n",
    "        print('   p%-3d %.2f cm' % (q, band(admitted, W, q) * 100))\n",
    "    loo = [band([t for j, t in enumerate(admitted) if j != i], W)\n",
    "           for i in range(len(admitted))]\n",
    "    print('   leave-one-out  %.2f-%.2f cm' % (min(loo) * 100, max(loo) * 100))"
   ]
