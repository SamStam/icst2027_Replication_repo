    "def fault_injection():\n",
    "    rows = []\n",
    "    for f in sorted(glob.glob(os.path.join(DATA, 'physical', 'handover', '*.csv'))):\n",
    "        d = pd.read_csv(f)\n",
    "        err, resume, n = handover_error(d)\n",
    "        rows.append({'run': os.path.basename(f)[:-13],\n",
    "                     'd_cm': err * 100, 'clock_s': resume, 'samples': n})\n",
    "    R = pd.DataFrame(rows)\n",
    "\n",
    "    control = R[R.run.str.contains('nominal|ctrl')]\n",
    "    med = float(np.median(control.d_cm))\n",
    "\n",
    "    print('\\nfault injection')\n",
    "    print(R.to_string(index=False, float_format='%.2f'))\n",
    "    print('\\ncontrol runs: %s' % ', '.join('%.2f' % v for v in sorted(control.d_cm)))\n",
    "    print('median %.2f cm, p90 %.2f cm'\n",
    "          % (med, float(np.percentile(control.d_cm, 90))))\n",
    "    return R, med"
   ]
  },
