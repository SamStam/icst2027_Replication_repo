   "source": [
    "def check_coherence(traces, W, k=COHERENCE_K):\n",
    "    \"\"\"Condition v. A trace can be clean and still not belong to the set.\"\"\"\n",
    "    g = [on_grid(d, W) for d in traces]\n",
    "    med = [np.median([rms(g[i], g[j]) for j in range(len(g)) if j != i])\n",
    "           for i in range(len(g))]\n",
    "    ref = float(np.median(med))\n",
    "    keep = [i for i, m in enumerate(med) if m <= k * ref]\n",
    "    return keep, med, ref"
   ]
  },
