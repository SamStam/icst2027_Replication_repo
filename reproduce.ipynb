   "source": [
    "def load(path):\n",
    "    d = pd.read_csv(path).sort_values('t_mission').reset_index(drop=True)\n",
    "    # tracking error, not absolute position: the simulation and Lighthouse\n",
    "    # origins differ, so absolute coordinates aren't comparable across runs\n",
    "    for c in AX:\n",
    "        d[f'e{c}'] = d[c] - d[f'sp_{c}']\n",
    "    d.attrs['id'] = os.path.basename(path)[-12:-4]\n",
    "    return d"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "967b1746",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-07T17:44:11.537098Z",
