    "def verdict(mission, admitted, twin_file, W):\n",
    "    twin = load(os.path.join(DATA, 'twin', twin_file))\n",
    "    p = pairwise(admitted, W)\n",
    "    B = float(np.percentile(p, 90))\n",
    "    d, each = deviation(twin, admitted, W)\n",
    "\n",
    "    print('\\n%s   n=%d   W=[%g,%g]' % (mission, len(admitted), *W))\n",
    "    print('   %d pairs, median %.2f, range %.2f-%.2f'\n",
    "          % (len(p), np.median(p) * 100, p[0] * 100, p[-1] * 100))\n",
    "    print('   B = %.2f cm' % (B * 100))\n",
    "    print('   d = %.2f cm   per flight: %s'\n",
    "          % (d * 100, ', '.join('%.2f' % (v * 100) for v in each)))\n",
    "    print('   d/B = %.2f   ->  %s'\n",
    "          % (d / B, 'non-conformant' if d > B else 'within band'))\n",
    "    return B, d"
   ]
  },
