    "# --- handover ---------------------------------------------------------\n"
    "\n",
    "def handover_error(d):\n",
    "    a = d[d.note.astype(str).str.endswith('|A')]\n",
    "    b = d[d.note.astype(str).str.endswith('|B')]\n",
    "    last_a = a[AX].iloc[-1].values\n",
    "\n",
    "    hold = b[b.phase == 'rendezvous']\n",
    "    hold = hold[hold.t_mission > hold.t_mission.median()]\n",
    "    err = float(np.linalg.norm(hold[AX].mean().values - last_a))\n",
    "\n",
    "    after = b[~b.phase.isin(['approche', 'rendezvous'])]\n",
    "    resume = float(after.t_mission.min()) if len(after) else np.nan\n",
    "    return err, resume, len(d)"
   ]
  },
