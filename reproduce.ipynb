    "import glob\n",
    "import os\n",
    "from itertools import combinations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "DATA = 'data'           # run from the folder that holds this file\n",
    "AX = ['x', 'y', 'z']\n",
    "HZ = 50\n",
    "\n",
    "W_SQUARE = (5.0, 20.0)\n",
    "W_EXCIT = (8.0, 38.5)\n",
    "\n",
    "# samples a complete mission produces at 50 Hz\n",
    "N_NOMINAL = {'square': 1225, 'excitation': 2150}\n",
    "\n",
    "MIN_COMPLETE = 0.98\n",
    "JUMP_REPAIR = 0.10      # isolated glitch, interpolated\n",
    "JUMP_REJECT = 0.20      # frame discontinuity, trace thrown out\n",
    "REPAIR_BUDGET = 0.01\n",
    "FROZEN_RUN = 100        # consecutive identical samples = dead link\n",
    "COHERENCE_K = 3.0"
   ]
  },
